# Copy to .env, then fill the token, bot username and your Bale user ID.
BOT_PLATFORM=bale
TELEGRAM_BOT_TOKEN=your_bale_bot_token
TELEGRAM_BOT_USERNAME=your_bale_bot_username
APPROVED_DIRECTORY=/home/amirreza/Desktop/bale/projects/bale_repo/my_projects
ALLOWED_USERS=123456789
USE_SDK=true
ENABLE_STREAM_DRAFTS=false
ENABLE_PROJECT_THREADS=false
# Leave WEBHOOK_URL unset to use long polling (no public endpoint required).
